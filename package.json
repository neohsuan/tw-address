{
  "name": "@hsuan741220/tw-address",
  "version": "1.0.0",
  "description": "Zero-dependency Taiwan address parser, normalizer and three-digit postal code lookup",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "generate:data": "node scripts/generate-data.mjs",
    "build": "tsup",
    "test": "npm run build && vitest run",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack .",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neohsuan/tw-address.git"
  },
  "homepage": "https://github.com/neohsuan/tw-address#readme",
  "bugs": {
    "url": "https://github.com/neohsuan/tw-address/issues"
  },
  "author": "neohsuan",
  "license": "MIT",
  "keywords": [
    "taiwan",
    "address",
    "parser",
    "normalizer",
    "postal-code",
    "zip3",
    "typescript",
    "台灣地址",
    "郵遞區號"
  ],
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
